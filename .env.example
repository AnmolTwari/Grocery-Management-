# Environment variables for the Grocery Manager Spring Boot backend.
#
# Copy the variable NAMES shown here to your actual environment.
# NEVER put real secrets in a committed file - provide them as real
# environment variables (export ..., or set them in your deployment panel).

# Active profile: dev (default) or prod
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL - hosted on Supabase (used only as a Postgres host)
DB_URL=jdbc:postgresql://db.skzvyqtdufbemaqywxjo.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your-database-password